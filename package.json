{
  "name": "knex-snowflake-dialect",
  "version": "2.0.3",
  "description": "knex.js dialect for the Snowflake data warehouse",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib/",
    "deploy": "npm version patch && npm publish --declaration",
    "lint": "eslint src",
    "lint-fix": "eslint src --fix",
    "test": "npm run lint && jest --runInBand --silent --forceExit --detectOpenHandles",
    "coverage": "jest --coverage --silent && open coverage/lcov-report/index.html",
    "prepush": "npm test uspec",
    "tslint-check": "tslint-config-prettier-check ./tslint.json",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiplana/data-knex-snowflake-dialect.git"
  },
  "author": "insightsoftware",
  "keywords": [
    "knex",
    "snowflake"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fiplana/data-knex-snowflake-dialect/issues"
  },
  "homepage": "https://github.com/fiplana/data-knex-snowflake-dialect#readme",
  "jest": {
    "automock": false,
    "transform": {
      ".(ts)": "ts-jest"
    },
    "testEnvironment": "node",
    "testRegex": "(\\.(ispec|uspec))\\.(ts)$",
    "roots": [
      "<rootDir>/test"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  },
  "dependencies": {
    "bluebird": "^3.7.2",
    "lodash": "4.18.1",
    "snowflake-sdk": "3.1.0"
  },
  "peerDependencies": {
    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bluebird": "3.5.42",
    "@types/jest": "^30.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "^24.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "chai": "6.2.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "knex": "^3.3.0",
    "mocha": "11.7.6",
    "mysql": "2.18.1",
    "sinon": "^22.1.0",
    "sinon-chai": "4.0.1",
    "ts-jest": "29.4.11",
    "typescript": "5.3.3"
  },
  "overrides": {
    "axios": "1.15.2"
  }
}
